# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.local

# macOS
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/

# Raw data — PDFs are not committed (large files)
data/raw/*.pdf
!data/raw/.gitkeep

# Processed data: ignore everything by default (keep folder via .gitkeep).
# Only the canonical demo outputs consumed by the app for the 3 demo documents
# are tracked, so a clean clone can build and run the Docker demo.
data/processed/*
!data/processed/.gitkeep
!data/processed/latvia_sdc_2023_core_body_threat_matches.json
!data/processed/uk_sdr_2025_core_body_threat_matches.json
!data/processed/netherlands_dwp_2024_core_body_threat_matches.json
!data/processed/japan_doj_2026_core_body_threat_matches.json

# Runtime review decisions (keep folder via .gitkeep)
data/reviews/*.json
!data/reviews/.gitkeep
